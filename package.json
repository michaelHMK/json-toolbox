{
  "name": "json-toolbox",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test && python3 -m unittest discover -s tests -p 'test_*.py'",
    "bench": "node --expose-gc bench/format.mjs && node --expose-gc bench/search.mjs && node --expose-gc bench/diff.mjs",
    "check:release": "python3 build_release.py --check",
    "bench:performance": "node bench/performance.mjs",
    "bench:budget": "node --expose-gc bench/format.mjs --size-mib=25 --samples=3 --assert-ratio=3"
  }
}
